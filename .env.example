# Copy to .env and fill in. Never commit .env.

# Apollo API key (Settings > Integrations > API). One credit per enrich call.
APOLLO_API_KEY=

# Hard cap on live Apollo calls per run. Cached responses don't count.
APOLLO_MAX_LIVE_CALLS=15

# SEC requires "Name email" in the User-Agent header.
SEC_USER_AGENT="Your Name you@example.com"
